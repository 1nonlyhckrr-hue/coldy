# Never commit real credentials. These placeholders will fail production validation.
DISCORD_TOKEN=
DISCORD_CLIENT_ID=
DISCORD_GUILD_ID=
OWNER_IDS=
DATABASE_PATH=./var/luna.sqlite
LOG_LEVEL=info
NODE_ENV=development

# Enable only after granting the Server Members privileged intent.
ENABLE_MEMBER_EVENTS=false

# Enable only after granting the Message Content privileged intent.
ENABLE_MESSAGE_EVENTS=false

# Enable only for opt-in audit alerts with View Audit Log permission.
ENABLE_AUDIT_EVENTS=false

# Needed for voice utilities/tracked voice occupancy;non-privileged GuildVoiceStates.
ENABLE_VOICE_EVENTS=false
